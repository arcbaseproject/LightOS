#!/bin/sh
# light-install: install LightOS from the live system to a disk.
# Menu-driven like archinstall: set each item in any order, then choose Install.
# Disk layout: GPT. 1: 1 MiB BIOS boot (limine stage 2), 2: 256 MiB EFI system partition
# (FAT32, mounted at /boot), 3: ext4 root. limine boots the result on BIOS and UEFI.

TITLE="LightOS Installer"
MNT=/mnt/lightos
KM=/usr/share/bkeymaps
ZI=/usr/share/zoneinfo

[ "$(id -u)" = 0 ] || { echo "light-install: run as root" >&2; exit 1; }
command -v dialog >/dev/null || { echo "light-install: needs dialog (lpkg add dialog)" >&2; exit 1; }
WORK=$(mktemp -d /tmp/light-install.XXXXXX) || exit 1
LOG=$WORK/install.log
RC=$WORK/status

export DIALOGRC=/etc/lightos/dialogrc
# Draw boxes with Unicode line characters; the DEC line-drawing set breaks on some serial terminals.
export NCURSES_NO_UTF8_ACS=1
# A serial console can't report its window size; ask the terminal so dialog uses the full window.
case $(tty) in /dev/ttyS*) resize >/dev/null ;; esac

# dialog draws on the terminal and prints the answer on stderr; swap so $(D ...) captures it.
D() { dialog --colors --backtitle "$TITLE" "$@" 3>&1 1>&2 2>&3; }
msg() { D --msgbox "$1" ${2:-7} 60; }
quit() { clear; echo "light-install: aborted, nothing was changed"; exit 1; }

human() { awk -v b="$1" 'BEGIN { split("B KiB MiB GiB TiB", u); i = 1
  while (b >= 1024 && i < 5) { b /= 1024; i++ } printf "%.1f %s", b, u[i] }'; }
disksize() { human $(( $(cat /sys/block/$1/size) * 512 )); }

# Partition device: sda + 1 -> sda1, nvme0n1 + 1 -> nvme0n1p1
part() { case $1 in *[0-9]) echo "/dev/${1}p$2" ;; *) echo "/dev/$1$2" ;; esac; }

# Check device numbers, not mount source names: mounts may use aliases or UUIDs.
disk_available() (
  [ -b "/dev/$1" ] && [ -r "/sys/block/$1/dev" ] || exit 1
  [ "$(cat "/sys/block/$1/ro")" = 0 ] || exit 1
  for node in /sys/block/"$1" /sys/block/"$1"/*; do
    [ -r "$node/dev" ] || continue
    dev=$(cat "$node/dev") || exit 1
    awk -v dev="$dev" '$3 == dev { found=1 } END { exit found }' /proc/self/mountinfo || exit 1
    for holder in "$node"/holders/*; do [ ! -e "$holder" ] || exit 1; done
    while read -r swap rest; do
      [ "$swap" != Filename ] || continue
      hex=$(stat -L -c '%t %T' "$swap") || exit 1
      set -- $hex
      [ "$(printf '%d:%d' "0x$1" "0x$2")" != "$dev" ] || exit 1
    done < /proc/swaps || exit 1
  done
)

user_available() {
  awk -F: -v name="$1" '$1 == name { found=1 } END { exit found }' /etc/passwd /etc/group
}

# --- Settings and defaults ---
KEYMAP=          # empty: US, the kernel's built-in layout
LOCALE=C.UTF-8
DISK=
HOST=lightos
ROOTPW=
USERNAME= USERPW= USERSUDO=yes
TZONE=UTC
NTP=yes
NETWORK=dhcp
EXTRA=
DESKTOP=none

# Save the current (US) layout so choosing "us" again can restore it. VT only, not serial.
dumpkmap > "$WORK/us.bmap" 2>/dev/null

# --- Item editors. Cancel or Esc leaves the setting unchanged. ---

set_keymap() {
  set -- us
  for d in $KM/*/; do d=${d%/}; set -- "$@" "${d##*/}"; done
  lang=$(D --title " Keyboard layout " --no-items --default-item "${KEYMAP%%/*}" --menu "Layout:" 0 0 0 "$@") || return 0
  if [ "$lang" = us ]; then
    KEYMAP=
    loadkmap < "$WORK/us.bmap" 2>/dev/null
    return 0
  fi
  set --
  for f in $KM/$lang/*.bmap.gz; do f=${f##*/}; set -- "$@" "${f%.bmap.gz}"; done
  if [ $# -gt 1 ]; then
    var=$(D --title " Keyboard layout " --no-items --default-item "$lang" --menu "Variant:" 0 0 0 "$@") || return 0
  else
    var=$1
  fi
  KEYMAP=$lang/$var
  # Apply now, so the passwords you type next use this layout.
  zcat "$KM/$KEYMAP.bmap.gz" | loadkmap 2>/dev/null
}

set_locale() {
  set -- C.UTF-8
  for f in /usr/share/i18n/locales/musl/*; do set -- "$@" "${f##*/}"; done
  l=$(D --title " Locale " --no-items --default-item "$LOCALE" --menu "System language (LANG):" 0 0 0 "$@") && LOCALE=$l
}

set_disk() {
  set --
  for s in /sys/block/*; do
    n=${s##*/}
    case $n in loop*|ram*|sr*|zram*|dm-*|md*) continue ;; esac
    [ $(( $(cat "$s/size") * 512 )) -ge 1073741824 ] || continue   # skip disks under 1 GiB
    disk_available "$n" || continue                               # skip disks in use
    model=$(cat "$s/device/model" 2>/dev/null | tr -s ' ')
    set -- "$@" "$n" "$(disksize "$n")  ${model:-disk}"
  done
  [ $# -gt 0 ] || { msg "No usable disk found (1 GiB or larger, not in use)."; return 0; }
  d=$(D --title " Disk " --default-item "$DISK" --menu "Disk to install LightOS on.\nEverything on it will be erased." 0 0 0 "$@") && DISK=$d
}

set_hostname() {
  while h=$(D --title " Hostname " --inputbox "Name for this computer:" 8 60 "$HOST"); do
    case $h in ''|-*|*[!a-zA-Z0-9-]*) msg "Use letters, digits and dashes only." ;; *) HOST=$h; return ;; esac
  done
}

ask_password() { # label; prints the password, fails on cancel
  while :; do
    p1=$(D --insecure --title " $1 " --passwordbox "Password for $1:" 8 60) || return 1
    p2=$(D --insecure --title " $1 " --passwordbox "Type it again:" 8 60) || return 1
    if [ -z "$p1" ]; then msg "The password can't be empty."
    elif [ "$p1" != "$p2" ]; then msg "The passwords don't match."
    else printf '%s\n' "$p1"; return 0; fi
  done
}

set_rootpw() { p=$(ask_password root) && ROOTPW=$p; }

set_user() {
  if [ -n "$USERNAME" ]; then
    a=$(D --title " User account " --menu "User: $USERNAME" 0 0 0 change "Change the user" remove "Remove the user") || return 0
    [ "$a" = remove ] && { USERNAME=; USERPW=; return 0; }
  fi
  while u=$(D --title " User account " --inputbox "Username:" 8 60 "$USERNAME"); do
    case $u in
      root) msg "Pick a name other than root." ;;
      ''|[!a-z_]*|*[!a-z0-9_-]*) msg "Use lowercase letters, digits, - and _, starting with a letter." ;;
      *) user_available "$u" || { msg "That user or group already exists. Pick another name."; continue; }
         p=$(ask_password "$u") || return 0
         if D --title " User account " --yesno "Let $u run commands as root with sudo?" 6 50; then USERSUDO=yes; else USERSUDO=no; fi
         USERNAME=$u USERPW=$p
         return 0 ;;
    esac
  done
}

set_timezone() {
  r=$(D --title " Timezone " --no-items --default-item "${TZONE%%/*}" --menu "Region:" 0 0 0 \
    UTC Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific) || return 0
  [ "$r" = UTC ] && { TZONE=UTC; return 0; }
  # Zone names contain no spaces, so word splitting is safe here.
  # shellcheck disable=SC2046
  set -- $(cd $ZI && find "$r" -type f | sort)
  t=$(D --title " Timezone " --no-items --default-item "$TZONE" --menu "City:" 0 0 0 "$@") && TZONE=$t
}

set_ntp() {
  if D --title " Time sync " --yesno "Sync the clock over the internet (NTP) at boot?" 6 54; then NTP=yes; else NTP=no; fi
}

set_network() {
  n=$(D --title " Network " --default-item "$NETWORK" --menu "Network setup:" 0 0 0 \
    dhcp "Wired, automatic (DHCP on eth0)" none "No network") && NETWORK=$n
}

set_desktop() {
  set -- none "Console only"
  while IFS='|' read -r name desc; do set -- "$@" "$name" "$desc"; done <<EOF
$(/usr/local/sbin/setup-desktop --list)
EOF
  d=$(D --title " Desktop " --default-item "$DESKTOP" --menu "A desktop you reach over VNC (port 5901).\nIt runs as your user account and needs the network to download.\nThe VNC password is the user's password; VNC only checks its first 8 characters.\nYou can also add one later with setup-desktop." 0 0 0 "$@") && DESKTOP=$d
}

set_extra() {
  while e=$(D --title " Extra packages " --inputbox "Alpine packages to install, separated by spaces.\nNeeds a network connection during install." 9 64 "$EXTRA"); do
    case $e in *[!a-z0-9._+\ -]*) msg "Package names use lowercase letters, digits and . _ + -" ;; *) EXTRA=$(echo $e); return ;; esac
  done
}

summary() {
  echo "Keyboard layout:  ${KEYMAP:-us}"
  echo "Locale:           $LOCALE"
  echo "Disk:             ${DISK:+/dev/$DISK ($(disksize $DISK))}"
  echo "Hostname:         $HOST"
  echo "Root password:    ${ROOTPW:+set}"
  echo "User account:     ${USERNAME:-none}${USERNAME:+ (sudo: $USERSUDO)}"
  echo "Timezone:         $TZONE"
  echo "Time sync (NTP):  $NTP"
  echo "Network:          $NETWORK"
  echo "Desktop:          $DESKTOP"
  echo "Extra packages:   ${EXTRA:-none}"
}

# --- Install. Runs with stdout/stderr in $LOG and progress on fd 3; any failing command aborts. ---

progress() { printf 'XXX\n%s\n%s\nXXX\n' "$1" "$2" >&3; }

cleanup() {
  for m in $MNT/dev $MNT/proc $MNT/boot $MNT; do mountpoint -q $m && umount $m; done
}

do_install() {
  set -e
  exec 3>&1 >>$LOG 2>&1
  BOOT=$(part "$DISK" 2); ROOT=$(part "$DISK" 3)
  ROOTUUID=$(cat /proc/sys/kernel/random/uuid)

  progress 5 "Partitioning /dev/$DISK"
  disk_available "$DISK" || { echo "Disk unavailable or in use: /dev/$DISK"; exit 1; }
  printf 'label: gpt\nsize=1MiB, type=21686148-6449-6E6F-744E-656564454649, name=bios\nsize=256MiB, type=uefi, name=boot\ntype=linux, name=root, uuid=%s\n' "$ROOTUUID" |
    sfdisk --wipe always --wipe-partitions always "/dev/$DISK"
  i=0; until [ -b "$ROOT" ]; do i=$((i + 1)); [ $i -le 10 ]; sleep 1; done

  progress 12 "Formatting partitions"
  mkfs.vfat -F 32 -n LIGHTBOOT "$BOOT"
  mkfs.ext4 -q -F -L lightos "$ROOT"
  mkdir -p $MNT
  mount "$ROOT" $MNT
  mkdir $MNT/boot
  mount "$BOOT" $MNT/boot

  progress 20 "Copying the system"
  for d in bin etc home lib media opt root sbin srv usr var; do cp -a /$d $MNT/; done
  mkdir -p $MNT/proc $MNT/sys $MNT/dev $MNT/run $MNT/mnt $MNT/tmp
  chmod 1777 $MNT/tmp

  progress 55 "Configuring"
  cp -a /usr/share/lightos/installed/etc/. $MNT/etc/
  # The live session's machine-id; OpenRC makes a new one on first boot.
  rm -f $MNT/etc/machine-id
  echo "$HOST" > $MNT/etc/hostname
  printf '127.0.1.1\t%s\n' "$HOST" >> $MNT/etc/hosts
  BOOTUUID=$(blkid "$BOOT" | sed -n 's/.* UUID="\([^"]*\)".*/\1/p')
  [ -n "$BOOTUUID" ]
  printf 'UUID=%s\t/boot\tvfat\tdefaults\t0 2\n' "$BOOTUUID" >> $MNT/etc/fstab
  # Root is mounted read-only at boot so fsck can check it; OpenRC remounts it read-write from here.
  printf 'PARTUUID=%s\t/\text4\trw,relatime\t0 1\n' "$ROOTUUID" >> $MNT/etc/fstab
  if [ -n "$KEYMAP" ]; then echo "KEYMAP=/usr/share/bkeymaps/$KEYMAP.bmap.gz" > $MNT/etc/conf.d/loadkmap; fi
  printf 'auto lo\niface lo inet loopback\n' > $MNT/etc/network/interfaces
  [ "$NETWORK" = none ] || printf '\nauto eth0\niface eth0 inet dhcp\n' >> $MNT/etc/network/interfaces
  [ "$NTP" = no ] || ln -sfn /etc/init.d/ntpd $MNT/etc/runlevels/default/ntpd
  printf 'export LANG=%s\n' "$LOCALE" > $MNT/etc/profile.d/locale.sh
  ln -sf "../usr/share/zoneinfo/$TZONE" $MNT/etc/localtime
  echo "$TZONE" > $MNT/etc/timezone
  mount --bind /dev $MNT/dev
  mount -t proc proc $MNT/proc
  printf 'root:%s\n' "$ROOTPW" | chroot $MNT chpasswd
  if [ -n "$USERNAME" ]; then
    chroot $MNT adduser -D -s /bin/sh "$USERNAME"
    printf '%s:%s\n' "$USERNAME" "$USERPW" | chroot $MNT chpasswd
    if [ "$USERSUDO" = yes ]; then
      chroot $MNT addgroup "$USERNAME" wheel
      echo 'permit persist :wheel' > $MNT/etc/doas.d/wheel.conf
      chmod 600 $MNT/etc/doas.d/wheel.conf
    fi
  fi

  if [ -n "$EXTRA" ]; then
    progress 65 "Installing extra packages: $EXTRA"
    cp /etc/resolv.conf $MNT/etc/resolv.conf
    # shellcheck disable=SC2086
    chroot $MNT apk add $EXTRA
  fi

  if [ "$DESKTOP" != none ]; then
    progress 72 "Installing the $DESKTOP desktop"
    cp /etc/resolv.conf $MNT/etc/resolv.conf
    printf '%s\n' "$USERPW" | chroot $MNT /usr/local/sbin/setup-desktop --no-start "$DESKTOP" "$USERNAME"
  fi

  progress 85 "Installing the bootloader"
  cp /usr/share/lightos/bzImage /usr/share/limine/limine-bios.sys $MNT/boot/
  mkdir -p $MNT/boot/EFI/BOOT
  cp /usr/share/limine/BOOTX64.EFI $MNT/boot/EFI/BOOT/
  cat > $MNT/boot/limine.conf <<EOF
timeout: 3

/LightOS
    protocol: linux
    path: boot():/bzImage
    cmdline: root=PARTUUID=$ROOTUUID rootwait ro console=ttyS0 console=tty0 quiet
EOF
  limine bios-install "/dev/$DISK" 1

  progress 95 "Finishing"
  sync
  cleanup
  progress 100 "Done"
}

install() {
  [ -n "$DISK" ] || { msg "Choose a disk first."; return; }
  [ -n "$ROOTPW" ] || { msg "Set a root password first."; return; }
  disk_available "$DISK" || { msg "Disk unavailable or in use. Choose another disk."; return; }
  if [ -n "$USERNAME" ] && ! user_available "$USERNAME"; then
    msg "That user or group already exists. Choose another username."; return
  fi
  if [ "$DESKTOP" != none ] && [ -z "$USERNAME" ]; then
    msg "The desktop runs as a user account. Add one under User account." 8; return
  fi
  if { [ -n "$EXTRA" ] || [ "$DESKTOP" != none ]; } && [ "$NETWORK" = none ]; then
    msg "Extra packages and the desktop need the network. Set Network to dhcp." 8; return
  fi
  D --title " Confirm " --cr-wrap --no-collapse --defaultno --yes-label "Install" --no-label "Back" --yesno \
    "\n$(summary)\n\n\Z1\ZbALL DATA ON /dev/$DISK WILL BE ERASED.\Zn\n\nInstall LightOS now?" 0 0 || return

  : > $LOG
  ( ( do_install ); echo $? > $RC ) | D --title " Installing " --gauge "Starting" 8 64 0
  if [ "$(cat $RC)" != 0 ]; then
    cleanup 2>/dev/null
    D --title " Installation failed " --msgbox "Last lines of $LOG:\n\n$(tail -n 12 $LOG)" 20 76
    clear; echo "light-install: failed, see $LOG"; exit 1
  fi
  if D --title " Done " --yesno "LightOS is installed on /dev/$DISK.\n\nRemove the installation media, then reboot.\nReboot now?" 10 60; then
    clear; reboot; exit 0
  fi
  clear; echo "light-install: done. Reboot to start LightOS."; exit 0
}

# --- Main menu ---
item="Disk *"
while :; do
  unset_='\Z1\Zbnot set\Zn'
  dval=$unset_; [ -n "$DISK" ] && dval="/dev/$DISK ($(disksize "$DISK"))"
  pval=$unset_; [ -n "$ROOTPW" ] && pval=set
  item=$(D --title " Main menu " --cancel-label "Abort" --default-item "$item" --menu \
    "\nSet each item, then choose \ZbInstall\Zn.\nItems marked * are required." 22 60 13 \
    "Keyboard layout" "${KEYMAP:-us}" \
    "Locale" "$LOCALE" \
    "Disk *" "$dval" \
    "Hostname" "$HOST" \
    "Root password *" "$pval" \
    "User account" "${USERNAME:-none}${USERNAME:+ (sudo: $USERSUDO)}" \
    "Timezone" "$TZONE" \
    "Time sync (NTP)" "$NTP" \
    "Network" "$NETWORK" \
    "Desktop" "$DESKTOP" \
    "Extra packages" "${EXTRA:-none}" \
    "Install" "" \
    "Abort" "") || item=Abort
  case $item in
    "Keyboard layout") set_keymap ;;
    Locale) set_locale ;;
    "Disk *") set_disk ;;
    Hostname) set_hostname ;;
    "Root password *") set_rootpw ;;
    "User account") set_user ;;
    Timezone) set_timezone ;;
    "Time sync (NTP)") set_ntp ;;
    Network) set_network ;;
    Desktop) set_desktop ;;
    "Extra packages") set_extra ;;
    Install) install ;;
    Abort) D --title " Abort " --yesno "Quit the installer? Nothing has been changed." 6 50 && quit; item=Install ;;
  esac
done
