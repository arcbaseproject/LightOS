#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
hostname lightos
echo "Welcome to LightOS"
ip link set lo up
ip link set eth0 up && udhcpc -i eth0 -q -t 5 -n
# Live (initramfs) boot only: mount a data disk over /root, formatting it on first boot.
if [ -e /init ] && [ -b /dev/vda ]; then
  [ -n "$(blkid /dev/vda)" ] || mke2fs -q -L lightos /dev/vda
  mount /dev/vda /root
fi
