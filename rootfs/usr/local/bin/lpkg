#!/bin/sh
# lpkg: LightOS package manager. Installs static tarballs listed in /etc/lpkg/index
# into /root/opt (on the persistent disk). The index ships inside the image, so
# its sha256 sums are the trust anchor: busybox wget does not check certificates.
INDEX=/etc/lpkg/index
PREFIX=/root/opt
DB=$PREFIX/.lpkg

die() { echo "lpkg: $*" >&2; exit 1; }

install_pkg() {
  line=$(awk -v n="$1" '$1==n' "$INDEX")
  [ -n "$line" ] || die "no package '$1' (see: lpkg avail)"
  set -- $line
  [ -f "$DB/$1" ] && { echo "$1 already installed ($(head -1 "$DB/$1"))"; return; }
  mkdir -p "$DB"
  tmp=$(mktemp) || die "mktemp failed"
  echo "Downloading $1 $2"
  wget -q -O "$tmp" "$3" 2>/dev/null || { rm -f "$tmp"; die "download failed: $3"; }
  [ "$(sha256sum "$tmp" | cut -d' ' -f1)" = "$4" ] || { rm -f "$tmp"; die "$1: sha256 mismatch, not installing"; }
  # Record version, then the file list, so remove knows what to delete.
  { echo "$2"; tar -tzf "$tmp" | grep -v '/$'; } > "$DB/$1"
  tar -xzf "$tmp" -C "$PREFIX" || { rm -f "$tmp" "$DB/$1"; die "$1: unpack failed"; }
  rm -f "$tmp"
  echo "Installed $1 $2"
}

remove_pkg() {
  [ -f "$DB/$1" ] || die "'$1' is not installed"
  tail -n +2 "$DB/$1" | while read -r f; do rm -f "$PREFIX/$f"; done
  rm -f "$DB/$1"
  echo "Removed $1"
}

[ -d /root ] && mountpoint -q /root || echo "lpkg: warning: /root is not on a disk, installs vanish at reboot" >&2

case "$1" in
  install) shift; [ $# -gt 0 ] || die "usage: lpkg install NAME..."; for p; do install_pkg "$p"; done ;;
  remove)  shift; [ $# -gt 0 ] || die "usage: lpkg remove NAME..."; for p; do remove_pkg "$p"; done ;;
  list)    for f in "$DB"/*; do [ -f "$f" ] && echo "${f##*/} $(head -1 "$f")"; done ;;
  avail)   awk '{print $1, $2}' "$INDEX" ;;
  *) echo "usage: lpkg install|remove NAME... | list | avail" >&2; exit 1 ;;
esac
